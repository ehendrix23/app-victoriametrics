#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community App: VictoriaMetrics
# Configures NGINX for use with VictoriaMetrics
# ==============================================================================

# Generate Ingress configuration
bashio::var.json \
    interface "$(bashio::app.ip_address)" \
    port "^$(bashio::app.ingress_port)" \
    | tempio \
        -template /etc/nginx/templates/ingress.gtpl \
        -out /etc/nginx/servers/ingress.conf

# Generate direct access configuration, if enabled.
if bashio::var.has_value "$(bashio::app.port 8428)"; then
    bashio::config.require.ssl

    # Ingress is authenticated by Home Assistant, the direct port is not.
    # VictoriaMetrics has no user accounts, so anything that can reach this
    # port can read every metric and delete the whole database. Requests are
    # therefore checked against Home Assistant, which also accepts the Basic
    # auth that scrapers and remote write clients can send.
    if bashio::config.true 'leave_front_door_open'; then
        bashio::log.warning
        bashio::log.warning "Authentication on the direct port is turned off!"
        bashio::log.warning "Anybody who can reach port $(bashio::app.port 8428)"
        bashio::log.warning "on this machine can read and delete your metrics."
        bashio::log.warning
    fi

    bashio::var.json \
        certfile "$(bashio::config 'certfile')" \
        keyfile "$(bashio::config 'keyfile')" \
        leave_front_door_open "^$(bashio::config 'leave_front_door_open' 'false')" \
        port "^$(bashio::app.port 8428)" \
        ssl "^$(bashio::config 'ssl')" \
        | tempio \
            -template /etc/nginx/templates/direct.gtpl \
            -out /etc/nginx/servers/direct.conf
fi
